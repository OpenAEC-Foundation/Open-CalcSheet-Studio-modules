'  <text x="'p_X(a_r + L_x/2)'" y="'p_y0 + 26'" text-anchor="middle" style="fill:#1E40AF; font-weight:700">L<tspan dy="2.5" font-size="8">x</tspan><tspan dy="-2.5"> = 'L_x/m' m</tspan></text>
'  <line x1="'p_x0 - 14'" y1="'p_Y(a_r)'" x2="'p_x0 - 14'" y2="'p_Y(a_r + L_y)'" style="stroke:#1E40AF; stroke-width:0.8"/>
'  <text x="'p_x0 - 18'" y="'p_Y(a_r + L_y/2) + 3'" text-anchor="end" style="fill:#1E40AF; font-weight:700">L<tspan dy="2.5" font-size="8">y</tspan><tspan dy="-2.5"> = 'L_y/m' m</tspan></text>
'  <text x="'p_X(B_x) + 8'" y="'p_Y(B_y) + 10'" style="fill:#334155">'n_r' × 'n_r' velden</text>
'  <text x="'p_X(B_x) + 8'" y="'p_Y(B_y) + 24'" style="fill:#334155">rand a<tspan dy="2.5" font-size="8">r</tspan><tspan dy="-2.5"> = 'a_r/m' m</tspan></text>
'  <circle cx="'p_X(B_x) + 13'" cy="'p_Y(B_y) + 38'" r="3" style="fill:#1e293b"/><text x="'p_X(B_x) + 22'" y="'p_Y(B_y) + 42'" style="fill:#334155">paal Ø'd_kop/mm'</text>
#if kop ≡ 1
'  <rect x="'p_X(B_x) + 8'" y="'p_Y(B_y) + 50'" width="10" height="10" style="fill:#475569; fill-opacity:0.55"/><text x="'p_X(B_x) + 22'" y="'p_Y(B_y) + 59'" style="fill:#334155">ponskop 'b_k/mm' × 't_kd/mm'</text>
#end if
#if st_x + st_y > 0
'  <rect x="'p_X(B_x) + 8'" y="'p_Y(B_y) + 66'" width="10" height="10" style="fill:#94a3b8; fill-opacity:0.45"/><text x="'p_X(B_x) + 22'" y="'p_Y(B_y) + 75'" style="fill:#334155">strook 'b_s/mm' × 't_sd/mm'</text>
#end if
'  <rect x="'p_X(B_x) + 8'" y="'p_Y(B_y) + 82'" width="10" height="10" style="fill:none; stroke:#b45309; stroke-dasharray:3 2"/><text x="'p_X(B_x) + 22'" y="'p_Y(B_y) + 91'" style="fill:#334155">wapening in 3D</text>
'</svg>'
#show

# Rekenmodel (Open FEM Studio)

'Plaatmodel met vierhoekige elementen (MITC4), maas L/12; de palen zijn veren, verdeeld over de paalkop. Momenten in kNm/m, positief is trek onder.
@fem vloer
  materiaal E_cm; ν
  maas a_m
  plaat 0; 0; B_x; B_y; h
  // de stroken over de paalrijen, binnen de vloer gehouden
  #if st_x
  #for j = 0 : n_r
  plaat 0; max(a_r + j*L_y - b_s/2; 0 m); B_x; min(a_r + j*L_y + b_s/2; B_y) - max(a_r + j*L_y - b_s/2; 0 m); t_sd
  #loop
  #end if
  #if st_y
  #for i = 0 : n_r
  plaat max(a_r + i*L_x - b_s/2; 0 m); 0; min(a_r + i*L_x + b_s/2; B_x) - max(a_r + i*L_x - b_s/2; 0 m); B_y; t_sd
  #loop
  #end if
  // een ponskop boven elke paal; de laatste plaat wint
  #if kop
  #for i = 0 : n_r
  #for j = 0 : n_r
  plaat max(a_r + i*L_x - b_k/2; 0 m); max(a_r + j*L_y - b_k/2; 0 m); min(a_r + i*L_x + b_k/2; B_x) - max(a_r + i*L_x - b_k/2; 0 m); min(a_r + j*L_y + b_k/2; B_y) - max(a_r + j*L_y - b_k/2; 0 m); t_kd
  #loop
  #loop
  #end if
  veren a_r; a_r; n_r + 1; n_r + 1; L_x; L_y; k_paal; d_kop
  geval EG
    eigengewicht 25 kN/m^3
  geval AFW
    vlaklast 1 kN/m^2
  // schaakbord: veld (i, j) met i + j even in Q1, oneven in Q2; de rand hoort bij het randveld
  geval Q1
    #for i = 0 : n_r - 1
    #for j = 0 : n_r - 1
    #if mod(i + j; 2) ≡ 0
    vlaklast 1 kN/m^2; if(i ≡ 0; 0 m; a_r + i*L_x); if(j ≡ 0; 0 m; a_r + j*L_y); if(i ≡ n_r - 1; B_x; a_r + (i + 1)*L_x) - if(i ≡ 0; 0 m; a_r + i*L_x); if(j ≡ n_r - 1; B_y; a_r + (j + 1)*L_y) - if(j ≡ 0; 0 m; a_r + j*L_y)
    #end if
    #loop
    #loop
  geval Q2
    #for i = 0 : n_r - 1
    #for j = 0 : n_r - 1
    #if mod(i + j; 2) ≡ 1
    vlaklast 1 kN/m^2; if(i ≡ 0; 0 m; a_r + i*L_x); if(j ≡ 0; 0 m; a_r + j*L_y); if(i ≡ n_r - 1; B_x; a_r + (i + 1)*L_x) - if(i ≡ 0; 0 m; a_r + i*L_x); if(j ≡ n_r - 1; B_y; a_r + (j + 1)*L_y) - if(j ≡ 0; 0 m; a_r + j*L_y)
    #end if
    #loop
    #loop
  combinatie UGT_vol = γ_Gd*EG + γ_Gd*f_afw*AFW + γ_Q*f_q*Q1 + γ_Q*f_q*Q2
  combinatie UGT_sb1 = γ_Gd*EG + γ_Gd*f_afw*AFW + γ_Q*f_q*Q1
  combinatie UGT_sb2 = γ_Gd*EG + γ_Gd*f_afw*AFW + γ_Q*f_q*Q2
  combinatie BGT = EG + f_afw*AFW + f_q*Q1 + f_q*Q2
@end
#hide
'Is er gerekend? Zonder antwoord van FEM Studio bestaat vloer_UGT_vol_R_max niet:
'dan mislukt deze regel en is gerekend geen 1 (NaN), en volgt hieronder niets uit het model.
gerekend = bool(vloer_UGT_vol_R_max > 0 kN)
#show
#if gerekend ≡ 1
#hide
'Langs richting r (1 = x, 2 = y): de overspanning L_a, de breedte dwars L_b.
L_a(r) = if(r ≡ 1; L_x; L_y)
L_b(r) = if(r ≡ 1; L_y; L_x)
'De halve breedte van een strook langs r (over de paalrij, draagt m_r) en van een strook dwars door de paal.
e_sa(r) = if(r ≡ 1; st_x; st_y)*b_s/2
e_sc(r) = if(r ≡ 1; st_y; st_x)*b_s/2
e_k = kop*b_k/2
'De paal-as langs r van paal i, en de paalrij dwars daarop.
a_p(r; i) = a_r + i*L_a(r)
b_p(r; j) = a_r + j*L_b(r)
'Het gemiddelde moment m_r over een lijn dwars op r: op afstand s langs r, van t1 tot t2 dwars.
m_l(c; r; s; t1; t2) = fem_strook(vloer; c; if(r ≡ 1; "mx"; "my"); if(r ≡ 1; s; t1); if(r ≡ 1; t1; s); if(r ≡ 1; s; t2); if(r ≡ 1; t2; s))
'Hetzelfde over twee gelijke stukken aan weerszijden van de paalrij b: van b + e1 tot b + e2 en gespiegeld.
m_2(c; r; s; b; e1; e2) = (m_l(c; r; s; b + e1; b + e2) + m_l(c; r; s; b - e2; b - e1))/2
'De omhullende over de drie UGT-combinaties: M het grootste veldmoment (trek onder), N het grootste steunmoment (trek boven, positief).
M_1(r; s; t1; t2) = max(m_l("UGT_vol"; r; s; t1; t2); m_l("UGT_sb1"; r; s; t1; t2); m_l("UGT_sb2"; r; s; t1; t2))
N_1(r; s; t1; t2) = -min(m_l("UGT_vol"; r; s; t1; t2); m_l("UGT_sb1"; r; s; t1; t2); m_l("UGT_sb2"; r; s; t1; t2))
M_2(r; s; b; e1; e2) = max(m_2("UGT_vol"; r; s; b; e1; e2); m_2("UGT_sb1"; r; s; b; e1; e2); m_2("UGT_sb2"; r; s; b; e1; e2))
N_2(r; s; b; e1; e2) = -min(m_2("UGT_vol"; r; s; b; e1; e2); m_2("UGT_sb1"; r; s; b; e1; e2); m_2("UGT_sb2"; r; s; b; e1; e2))
'Binnenpaal p_b en eerste binnenpaal 1, beide in paalrij p_b; veldmidden, rand van de verdikking rond de paal.
s_0(r) = a_p(r; p_b)
s_1(r) = a_p(r; 1)
s_m(r) = s_0(r) + L_a(r)/2
b_0(r) = b_p(r; p_b)
c_v(r) = max(e_k; e_sc(r))
t_as(r) = if(e_sc(r) > 0 m; t_sd; h)
'Veld (trek onder): middenstrook, kolomstrook buiten de strook, de strook zelf.
Z_1(r) = M_1(r; s_m(r); b_0(r) + L_b(r)/4; b_0(r) + 3*L_b(r)/4)
Z_2(r) = if(e_sa(r) < L_b(r)/4; M_2(r; s_m(r); b_0(r); e_sa(r); L_b(r)/4); 0 kN)
Z_3(r) = if(e_sa(r) > 0 m; M_1(r; s_m(r); b_0(r) - e_sa(r); b_0(r) + e_sa(r)); 0 kN)
'Boven de paal s (trek boven): kolomstrook op de paal-as buiten kop en strook, aan de rand van de verdikking, de strook, de kop, en de middenstrook.
Z_4(r; s) = N_2(r; s; b_0(r); max(e_k; e_sa(r)); L_b(r)/4)
'Aan de rand van een verdikking middelt FEM Studio de momenten per plaat, van één kant: daar telt ook
'de waarde die vanuit de dunne vloer (op 1, 2 en 3 mazen) naar de rand is doorgetrokken.
N_r(r; s) = N_2(r; s; b_0(r); e_sa(r); L_b(r)/4)
Z_5(r; s) = if(c_v(r) > 0 m; max(N_r(r; s + c_v(r)); 3*N_r(r; s + c_v(r) + a_m) - 3*N_r(r; s + c_v(r) + 2*a_m) + N_r(r; s + c_v(r) + 3*a_m)); 0 kN)
'De strook bij de paal: naast de kop op de paal-as, en met een kop ook aan de rand van de kop (doorgetrokken als hierboven).
N_s(r; s) = N_2(r; s; b_0(r); 0 m; e_sa(r))
Z_6(r; s) = if(e_sa(r) > 0 m; max(if(e_sa(r) > e_k; N_2(r; s; b_0(r); e_k; e_sa(r)); 0 kN); if(e_k > 0 m; max(N_s(r; s + e_k); 3*N_s(r; s + e_k + a_m) - 3*N_s(r; s + e_k + 2*a_m) + N_s(r; s + e_k + 3*a_m)); 0 kN)); 0 kN)
Z_7(r; s) = if(e_k > 0 m; N_1(r; s; b_0(r) - e_k; b_0(r) + e_k); 0 kN)
Z_8(r; s) = N_1(r; s; b_0(r) + L_b(r)/4; b_0(r) + 3*L_b(r)/4)
'Randveld: het eindveld langs r, op 0,3, 0,4 en 0,5·L van de buitenste paalrij.
R_f(r; f) = max(M_1(r; a_r + f*L_a(r); b_0(r) + L_b(r)/4; b_0(r) + 3*L_b(r)/4); if(e_sa(r) < L_b(r)/4; M_2(r; a_r + f*L_a(r); b_0(r); e_sa(r); L_b(r)/4); 0 kN))
R_s(r; f) = if(e_sa(r) > 0 m; M_1(r; a_r + f*L_a(r); b_0(r) - e_sa(r); b_0(r) + e_sa(r)); 0 kN)
'Randstrook langs de vrije rand: van de rand tot een kwart veld voorbij de buitenste paalrij;
'met een strook over de buitenste paalrij het dunne deel (R_r) en de strook zelf (R_e) apart.
R_r(r; s) = M_1(r; s; if(e_sa(r) > 0 m; a_r + e_sa(r); 0 m); a_r + L_b(r)/4)
R_e(r; s) = if(e_sa(r) > 0 m; M_1(r; s; max(a_r - e_sa(r); 0 m); a_r + e_sa(r)); 0 kN)
R_n(r; s) = N_1(r; s; a_r + max(e_k; e_sa(r)); a_r + L_b(r)/4)
#show
#end if

#if gerekend ≡ 1
# Momenten

#hide
k_mx = fem_svg(vloer; "UGT_vol"; "mx"; 280)
#show
@svg
{{k_mx}}
@end
'<i class="ook-afdruk">m<sub>x</sub> bij volle belasting (UGT); m<sub>y</sub> is bij gelijke paalafstanden het spiegelbeeld. Rood is trek boven, blauw trek onder.</i>
#pre
'<i>Dezelfde momenten in 3D: elk punt op de hoogte van zijn moment, trek onder omlaag. Draai het beeld met de muis.</i>
@3d
eenheid m
camera iso
hoogte 340
raster uit
assen uit
fem vloer UGT_vol mx
@end
#hide
'Statica van het binnenveld in x tussen paalrij 1 en 2 bij volle belasting: m_veld − (m_l + m_r)/2 = w·l_n²/8,
'met de doorsneden één maas buiten de paalkop, de ponskop en de dwarse strook (c_st): op de rand zelf
'middelt FEM Studio van één kant. Over de breedte L_y van één veld en over de hele vloer.
c_st = max(d_kop/2; e_k; e_sc(1)) + a_m
x_l = a_r + L_x + c_st
x_r = a_r + 2*L_x - c_st
x_m = (x_l + x_r)/2
l_n = x_r - x_l
y_0 = a_r + p_b*L_y
q_d = γ_Gd*(25 kN/m^3*h + g_afw) + γ_Q*q_k
q_s = γ_Gd*25 kN/m^3*(t_sd - h)
W_s = 0 m
#for j = 0 : n_r
W_s = W_s + st_x*(min(a_r + j*L_y + b_s/2; B_y) - max(a_r + j*L_y - b_s/2; 0 m))
#loop
M_vb = fem_strook(vloer; "UGT_vol"; "mx"; x_m; y_0 - L_y/2; x_m; y_0 + L_y/2)*L_y
M_lb = fem_strook(vloer; "UGT_vol"; "mx"; x_l; y_0 - L_y/2; x_l; y_0 + L_y/2)*L_y
M_rb = fem_strook(vloer; "UGT_vol"; "mx"; x_r; y_0 - L_y/2; x_r; y_0 + L_y/2)*L_y
M_vv = fem_strook(vloer; "UGT_vol"; "mx"; x_m; 0 m; x_m; B_y)*B_y
M_lv = fem_strook(vloer; "UGT_vol"; "mx"; x_l; 0 m; x_l; B_y)*B_y
M_rv = fem_strook(vloer; "UGT_vol"; "mx"; x_r; 0 m; x_r; B_y)*B_y
#pre
stat_b = (M_vb - (M_lb + M_rb)/2)/((q_d*L_y + q_s*st_x*b_s)*l_n^2/8)', statica binnenveld over L<sub>y</sub><span class="kolom-2"></span>'
stat_v = (M_vv - (M_lv + M_rv)/2)/((q_d*B_y + q_s*W_s)*l_n^2/8)', over de hele vloerbreedte<span class="kolom-2"></span>'
'<i>De statica van het binnenveld: het veldmoment min het gemiddelde steunmoment, over de breedte, gedeeld door w·l<sub>n</sub><sup>2</sup>/8, met l<sub>n</sub> = 'round(l_n/mm)' mm tussen de doorsneden één maas buiten de paalkop of de verdikking. Over de hele vloerbreedte is dit het evenwicht en hoort het 1 te zijn; over één veldbreedte gaat er ook wat dwarskracht over de lengtelijnen. Vlak naast de paal komt het lager uit, omdat FEM Studio de momenten op een knoop middelt.</i>
#show
#end if

# Wapening

ø_o = ?{12}*(mm)', net onder, Ø<span class="kolom-4"></span>'
s_o = ?{150}*(mm)', h.o.h.<span class="kolom-4"></span>'
ø_b = ?{10}*(mm)', net boven, Ø<span class="kolom-4"></span>'
s_b = ?{150}*(mm)', h.o.h.<span class="kolom-4"></span>'
ø_bb = ?{12}*(mm)', bijleg boven de palen, Ø<span class="kolom-4"></span>'
s_bb = ?{150}*(mm)', h.o.h.<span class="kolom-4"></span>'
ø_bs = ?{16}*(mm)', bijleg onder in de stroken, Ø<span class="kolom-4"></span>'
s_bs = ?{150}*(mm)', h.o.h.<span class="kolom-4"></span>'
@select ponswap "Ponswapening rond de paal (in beeld)"
  geen = 0
  deuvelrails = 1
@end
ø_pw = ?{12}*(mm)', ponswapening, Ø<span class="kolom-4"></span>'
n_pw = ?{3}', aantal omtrekken<span class="kolom-4"></span>'
'<i>De netten liggen over de hele vloer, de x-staven buiten. De bijleg boven ligt in beide richtingen over de kolomstrook (een half veld breed) boven elke paal; de bijleg onder ligt onder in de stroken. Hoeveel ponswapening nodig is, rekent de module Pons; hier staat ze alleen in beeld.</i><span class="alleen-scherm"></span>

#hide
'Per meter breedte (mm²/mm), en d van de binnenste laag bij dikte t.
a_o = π*ø_o^2/4/s_o
a_b = π*ø_b^2/4/s_b
a_bb = π*ø_bb^2/4/s_bb
a_bs = π*ø_bs^2/4/s_bs
d_o(t) = t - c_nom - ø_o - ø_o/2
d_b(t) = t - c_nom - ø_b - max(ø_b; ø_bb)/2
d_s = t_sd - c_nom - ø_bs/2 - if(st_x + st_y > 1; ø_bs; 0 mm)
'Het opneembaar moment per meter, z = 0,9·d, B500.
m_Ro(t) = a_o*f_yd*0.9*d_o(t) to kN
m_Rb(t) = a_b*f_yd*0.9*d_b(t) to kN
m_Rbb(t) = (a_b + a_bb)*f_yd*0.9*d_b(t) to kN
m_Rs = (a_o*d_o(h) + a_bs*d_s)*f_yd*0.9 to kN
#show

#if gerekend ≡ 1
#hide
'De zones, in beide richtingen. Een zone met meerdere gevallen (richting, paal, doorsnede) neemt het maatgevende: de grootste m/m_Rd.
o_1 = max(Z_1(1); Z_1(2))
o_2 = max(Z_2(1); Z_2(2))
o_3 = max(R_f(1; 0.3); R_f(1; 0.4); R_f(1; 0.5); R_f(2; 0.3); R_f(2; 0.4); R_f(2; 0.5))
o_4 = max(R_r(1; s_m(1)); R_r(2; s_m(2)); R_r(1; a_r + 0.3*L_x); R_r(1; a_r + 0.4*L_x); R_r(1; a_r + 0.5*L_x); R_r(2; a_r + 0.3*L_y); R_r(2; a_r + 0.4*L_y); R_r(2; a_r + 0.5*L_y))
o_5 = max(Z_3(1); Z_3(2); R_s(1; 0.3); R_s(1; 0.4); R_s(1; 0.5); R_s(2; 0.3); R_s(2; 0.4); R_s(2; 0.5); R_e(1; s_m(1)); R_e(2; s_m(2)); R_e(1; a_r + 0.4*L_x); R_e(2; a_r + 0.4*L_y))
'Middenstrook boven de paallijn: dikte t_as (in een dwarse strook dikker).
u_6x = max(Z_8(1; s_0(1)); Z_8(1; s_1(1)))/m_Rb(t_as(1))
u_6y = max(Z_8(2; s_0(2)); Z_8(2; s_1(2)))/m_Rb(t_as(2))
b_6 = max(Z_8(1; s_0(1)); Z_8(1; s_1(1)); Z_8(2; s_0(2)); Z_8(2; s_1(2)))
t_6 = if(u_6x ≥ u_6y; t_as(1); t_as(2))
'Kolomstrook boven de binnenpaal: op de paal-as (dikte t_as) en aan de rand van de verdikking (dikte h).
v_7 = [Z_4(1; s_0(1))/m_Rbb(t_as(1)); Z_5(1; s_0(1))/m_Rbb(h); Z_4(2; s_0(2))/m_Rbb(t_as(2)); Z_5(2; s_0(2))/m_Rbb(h)]
w_7 = [Z_4(1; s_0(1)); Z_5(1; s_0(1)); Z_4(2; s_0(2)); Z_5(2; s_0(2))]
q_7 = [t_as(1); h; t_as(2); h]
k_7 = take(1; order(-v_7))
b_7 = take(k_7; w_7)
t_7 = take(k_7; q_7)
'Kolomstrook boven de randpalen: de eerste binnenpaal (twee kanten) en de paal in de rand (één kant, naar binnen).
v_8 = [Z_4(1; s_1(1))/m_Rbb(t_as(1)); Z_5(1; s_1(1))/m_Rbb(h); Z_4(2; s_1(2))/m_Rbb(t_as(2)); Z_5(2; s_1(2))/m_Rbb(h); max(R_n(1; s_0(1)); R_n(1; s_1(1)))/m_Rbb(t_as(1)); max(R_n(2; s_0(2)); R_n(2; s_1(2)))/m_Rbb(t_as(2))]
w_8 = [Z_4(1; s_1(1)); Z_5(1; s_1(1)); Z_4(2; s_1(2)); Z_5(2; s_1(2)); max(R_n(1; s_0(1)); R_n(1; s_1(1))); max(R_n(2; s_0(2)); R_n(2; s_1(2)))]
q_8 = [t_as(1); h; t_as(2); h; t_as(1); t_as(2)]
k_8 = take(1; order(-v_8))
b_8 = take(k_8; w_8)
t_8 = take(k_8; q_8)
'Ponskop en strook boven de paal: de binnenpaal en de eerste binnenpaal.
b_9 = max(Z_7(1; s_0(1)); Z_7(1; s_1(1)); Z_7(2; s_0(2)); Z_7(2; s_1(2)))
b_10 = max(Z_6(1; s_0(1)); Z_6(1; s_1(1)); Z_6(2; s_0(2)); Z_6(2; s_1(2)))
'De piek op de paal, ter informatie.
m_pk(c) = -min(fem_waarde(vloer; c; "mx"; s_0(1); b_0(1)); fem_waarde(vloer; c; "mx"; s_1(1); b_0(1)); fem_waarde(vloer; c; "my"; b_0(2); s_0(2)); fem_waarde(vloer; c; "my"; b_0(2); s_1(2)))
m_piek = max(m_pk("UGT_vol"); m_pk("UGT_sb1"); m_pk("UGT_sb2"))
'Toetsing per zone.
UC_1 = o_1/m_Ro(h)
UC_2 = o_2/m_Ro(h)
UC_3 = o_3/m_Ro(h)
UC_4 = o_4/m_Ro(h)
UC_5 = if(st_x + st_y > 0; o_5/m_Rs; 0)
UC_6 = b_6/m_Rb(t_6)
UC_7 = b_7/m_Rbb(t_7)
UC_8 = b_8/m_Rbb(t_8)
UC_9 = if(kop ≡ 1; b_9/m_Rbb(t_kd); 0)
UC_10 = if(st_x + st_y > 0; b_10/m_Rbb(t_sd); 0)
UC_o = max(UC_1; UC_2; UC_3; UC_4)
UC_b = max(UC_6; UC_7; UC_8; UC_9; UC_10; UC_5)
#show
'<table style="width:100%; border-collapse:collapse; font-size:0.9em;">
'<tr style="border-bottom:1.5px solid #374151;"><th style="text-align:left; padding:1px 6px;">Zone</th><th style="text-align:right; padding:1px 6px;">m<sub>Ed</sub> [kNm/m]</th><th style="text-align:right; padding:1px 6px;">t [mm]</th><th style="text-align:left; padding:1px 6px;">wapening</th><th style="text-align:right; padding:1px 6px;">m<sub>Rd</sub> [kNm/m]</th><th style="text-align:right; padding:1px 6px;">UC</th></tr>
'<tr><td colspan="6" style="padding:3px 6px 1px; font-weight:700;">Trek onder</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Binnenveld, middenstrook</td><td style="text-align:right; padding:1px 6px;">'round(o_1/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'h/mm'</td><td style="padding:1px 6px;">net Ø'ø_o/mm'-'s_o/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Ro(h)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_1; 2)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Binnenveld, kolomstrook</td><td style="text-align:right; padding:1px 6px;">'round(o_2/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'h/mm'</td><td style="padding:1px 6px;">net Ø'ø_o/mm'-'s_o/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Ro(h)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_2; 2)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Randveld</td><td style="text-align:right; padding:1px 6px;">'round(o_3/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'h/mm'</td><td style="padding:1px 6px;">net Ø'ø_o/mm'-'s_o/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Ro(h)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_3; 2)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Hoekveld en randstrook</td><td style="text-align:right; padding:1px 6px;">'round(o_4/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'h/mm'</td><td style="padding:1px 6px;">net Ø'ø_o/mm'-'s_o/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Ro(h)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_4; 2)'</td></tr>
#if st_x + st_y > 0
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Strook, veld</td><td style="text-align:right; padding:1px 6px;">'round(o_5/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'t_sd/mm'</td><td style="padding:1px 6px;">net + Ø'ø_bs/mm'-'s_bs/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Rs/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_5; 2)'</td></tr>
#end if
'<tr><td colspan="6" style="padding:3px 6px 1px; font-weight:700;">Trek boven</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Middenstrook, op de paallijn</td><td style="text-align:right; padding:1px 6px;">'round(b_6/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'t_6/mm'</td><td style="padding:1px 6px;">net Ø'ø_b/mm'-'s_b/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Rb(t_6)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_6; 2)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Kolomstrook, binnenpaal</td><td style="text-align:right; padding:1px 6px;">'round(b_7/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'t_7/mm'</td><td style="padding:1px 6px;">net + Ø'ø_bb/mm'-'s_bb/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Rbb(t_7)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_7; 2)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Kolomstrook, randpalen</td><td style="text-align:right; padding:1px 6px;">'round(b_8/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'t_8/mm'</td><td style="padding:1px 6px;">net + Ø'ø_bb/mm'-'s_bb/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Rbb(t_8)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_8; 2)'</td></tr>
#if kop ≡ 1
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Ponskop</td><td style="text-align:right; padding:1px 6px;">'round(b_9/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'t_kd/mm'</td><td style="padding:1px 6px;">net + Ø'ø_bb/mm'-'s_bb/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Rbb(t_kd)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_9; 2)'</td></tr>
#end if
#if st_x + st_y > 0
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:1px 6px;">Strook, bij de paal</td><td style="text-align:right; padding:1px 6px;">'round(b_10/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'t_sd/mm'</td><td style="padding:1px 6px;">net + Ø'ø_bb/mm'-'s_bb/mm'</td><td style="text-align:right; padding:1px 6px;">'round(m_Rbb(t_sd)/kN; 1)'</td><td style="text-align:right; padding:1px 6px;">'round(UC_10; 2)'</td></tr>
#end if
'<tr style="border-bottom:1px solid #e5e7eb; color:#6b7280;"><td style="padding:1px 6px;">Piek op de paal (ter informatie)</td><td style="text-align:right; padding:1px 6px;">'round(m_piek/kN; 1)'</td><td colspan="4" style="padding:1px 6px;">spreidt over de kolomstrook</td></tr>
'</table>
'<i class="ook-afdruk">m<sub>Ed</sub> is de omhullende over volle belasting en beide schaakborden, gemiddeld over de zone (kolomstrook een half veld breed op de paallijn, NEN-EN 1992-1-1 bijlage I), in de maatgevende richting; d van de binnenste laag bij de werkelijke dikte t, z = 0,9·d.</i>

#hide
'Bijleg boven: zo ver als de kolomstrook meer vraagt dan het net boven, plus d en de verankeringslengte (8.4.3, matige hechting boven).
f_bd = 2.25*0.7*0.7*f_ctm/γ_c
l_bd = ø_bb/4*f_yd/f_bd to mm
z_x = 0 m
z_y = 0 m
#for k = 1 : 10
z_x = if(max(N_2(1; s_0(1) + k*L_x/20; b_0(1); 0 m; L_y/4); N_2(1; s_0(1) - k*L_x/20; b_0(1); 0 m; L_y/4); N_2(1; s_1(1) + k*L_x/20; b_0(1); 0 m; L_y/4); N_2(1; s_1(1) - k*L_x/20; b_0(1); 0 m; L_y/4)) > m_Rb(h); k*L_x/20; z_x)
z_y = if(max(N_2(2; s_0(2) + k*L_y/20; b_0(2); 0 m; L_x/4); N_2(2; s_0(2) - k*L_y/20; b_0(2); 0 m; L_x/4); N_2(2; s_1(2) + k*L_y/20; b_0(2); 0 m; L_x/4); N_2(2; s_1(2) - k*L_y/20; b_0(2); 0 m; L_x/4)) > m_Rb(h); k*L_y/20; z_y)
#loop
l_bx = min(2*ceil((z_x + d_b(h) + l_bd)/(50 mm))*50 mm; L_x) to m
l_by = min(2*ceil((z_y + d_b(h) + l_bd)/(50 mm))*50 mm; L_y) to m
'Stoelen tussen de netten: van de bovenkant van het net onder tot de onderkant van het net boven.
h_st = h - 2*c_nom - 2*ø_o - 2*ø_b
#show
l_bx', bijleg boven, lengte in x (over de paal)<span class="kolom-2"></span>'
l_by', lengte in y<span class="kolom-2"></span>'
h_st', stoelen tussen de netten (h.o.h. 1 m)<span class="kolom-2"></span>'
l_bd', verankeringslengte bijleg<span class="kolom-2"></span>'

#hide
'3D: de wapening rond de binnenpaal, een veld groot (u, v vanuit de paal). Beton als omtrek.
u_1 = L_x/2
v_1 = L_y/2
z_o1 = -h + c_nom + ø_o/2
z_o2 = -h + c_nom + 1.5*ø_o
z_b1 = -c_nom - ø_b/2
z_b2 = -c_nom - 1.5*ø_b
n_ox = floor(v_1/s_o)
n_oy = floor(u_1/s_o)
n_bx = floor(v_1/s_b)
n_by = floor(u_1/s_b)
n_jx = floor((L_y/4)/s_bb - 0.5)
n_jy = floor((L_x/4)/s_bb - 0.5)
n_kx = floor((b_k/2 - c_nom)/s_o)
n_sx = floor((b_s/2 - c_nom - ø_bs)/s_bs)
z_s = -t_sd + c_nom + ø_bs/2
z_k = -t_kd + c_nom + ø_o/2
s_st = 1 m
n_st = floor(v_1/s_st + 0.5)
n_zz = floor(L_x/(0.3 m))
p_zz = L_x/n_zz
z_st1 = z_b2 - ø_b/2 - 3 mm
z_st0 = z_o2 + ø_o/2 + 3 mm
t_loc(u; v) = max(h; if(And(kop ≡ 1; abs(u) ≤ b_k/2; abs(v) ≤ b_k/2); t_kd; h); if(And(st_x ≡ 1; abs(v) ≤ b_s/2); t_sd; h); if(And(st_y ≡ 1; abs(u) ≤ b_s/2); t_sd; h))
d_pw = d_b(t_p)
r_pw(i_w) = d_kop/2 + 0.5*d_pw + i_w*0.75*d_pw
n_p = round(max(n_pw; 1))
#pre
@3d
eenheid m
camera iso
hoogte 320
raster uit
assen uit
// beton: de vloer als omtrek
buis {{-u_1}} {{-v_1}} 0 {{u_1}} {{-v_1}} 0 0.005 grijs
buis {{-u_1}} {{v_1}} 0 {{u_1}} {{v_1}} 0 0.005 grijs
buis {{-u_1}} {{-v_1}} 0 {{-u_1}} {{v_1}} 0 0.005 grijs
buis {{u_1}} {{-v_1}} 0 {{u_1}} {{v_1}} 0 0.005 grijs
buis {{-u_1}} {{-v_1}} {{-h}} {{u_1}} {{-v_1}} {{-h}} 0.005 grijs
buis {{-u_1}} {{v_1}} {{-h}} {{u_1}} {{v_1}} {{-h}} 0.005 grijs
buis {{-u_1}} {{-v_1}} {{-h}} {{-u_1}} {{v_1}} {{-h}} 0.005 grijs
buis {{u_1}} {{-v_1}} {{-h}} {{u_1}} {{v_1}} {{-h}} 0.005 grijs
buis {{-u_1}} {{-v_1}} 0 {{-u_1}} {{-v_1}} {{-h}} 0.005 grijs
buis {{u_1}} {{-v_1}} 0 {{u_1}} {{-v_1}} {{-h}} 0.005 grijs
buis {{-u_1}} {{v_1}} 0 {{-u_1}} {{v_1}} {{-h}} 0.005 grijs
buis {{u_1}} {{v_1}} 0 {{u_1}} {{v_1}} {{-h}} 0.005 grijs
// de ponskop en de stroken onder de vloer
#if kop ≡ 1
buis {{-b_k/2}} {{-b_k/2}} {{-t_kd}} {{b_k/2}} {{-b_k/2}} {{-t_kd}} 0.005 grijs
buis {{-b_k/2}} {{b_k/2}} {{-t_kd}} {{b_k/2}} {{b_k/2}} {{-t_kd}} 0.005 grijs
buis {{-b_k/2}} {{-b_k/2}} {{-t_kd}} {{-b_k/2}} {{b_k/2}} {{-t_kd}} 0.005 grijs
buis {{b_k/2}} {{-b_k/2}} {{-t_kd}} {{b_k/2}} {{b_k/2}} {{-t_kd}} 0.005 grijs
buis {{-b_k/2}} {{-b_k/2}} {{-h}} {{-b_k/2}} {{-b_k/2}} {{-t_kd}} 0.005 grijs
buis {{b_k/2}} {{-b_k/2}} {{-h}} {{b_k/2}} {{-b_k/2}} {{-t_kd}} 0.005 grijs
buis {{-b_k/2}} {{b_k/2}} {{-h}} {{-b_k/2}} {{b_k/2}} {{-t_kd}} 0.005 grijs
buis {{b_k/2}} {{b_k/2}} {{-h}} {{b_k/2}} {{b_k/2}} {{-t_kd}} 0.005 grijs
#end if
#if st_x ≡ 1
buis {{-u_1}} {{-b_s/2}} {{-t_sd}} {{u_1}} {{-b_s/2}} {{-t_sd}} 0.005 grijs
buis {{-u_1}} {{b_s/2}} {{-t_sd}} {{u_1}} {{b_s/2}} {{-t_sd}} 0.005 grijs
buis {{-u_1}} {{-b_s/2}} {{-h}} {{-u_1}} {{-b_s/2}} {{-t_sd}} 0.005 grijs
buis {{-u_1}} {{b_s/2}} {{-h}} {{-u_1}} {{b_s/2}} {{-t_sd}} 0.005 grijs
buis {{u_1}} {{-b_s/2}} {{-h}} {{u_1}} {{-b_s/2}} {{-t_sd}} 0.005 grijs
buis {{u_1}} {{b_s/2}} {{-h}} {{u_1}} {{b_s/2}} {{-t_sd}} 0.005 grijs
#end if
#if st_y ≡ 1
buis {{-b_s/2}} {{-v_1}} {{-t_sd}} {{-b_s/2}} {{v_1}} {{-t_sd}} 0.005 grijs
buis {{b_s/2}} {{-v_1}} {{-t_sd}} {{b_s/2}} {{v_1}} {{-t_sd}} 0.005 grijs
buis {{-b_s/2}} {{-v_1}} {{-h}} {{-b_s/2}} {{-v_1}} {{-t_sd}} 0.005 grijs
buis {{b_s/2}} {{-v_1}} {{-h}} {{b_s/2}} {{-v_1}} {{-t_sd}} 0.005 grijs
buis {{-b_s/2}} {{v_1}} {{-h}} {{-b_s/2}} {{v_1}} {{-t_sd}} 0.005 grijs
buis {{b_s/2}} {{v_1}} {{-h}} {{b_s/2}} {{v_1}} {{-t_sd}} 0.005 grijs
#end if
// de paal
buis 0 0 {{-t_p - 0.9 m}} 0 0 {{-t_p}} {{d_kop}} beton
// net onder: x-staven onder, y-staven erop
#for k = -n_ox : n_ox
buis {{-u_1}} {{k*s_o}} {{z_o1}} {{u_1}} {{k*s_o}} {{z_o1}} {{ø_o}} #2563eb
#loop
#for k = -n_oy : n_oy
buis {{k*s_o}} {{-v_1}} {{z_o2}} {{k*s_o}} {{v_1}} {{z_o2}} {{ø_o}} #2563eb
#loop
// net boven: x-staven boven, y-staven eronder
#for k = -n_bx : n_bx
buis {{-u_1}} {{k*s_b}} {{z_b1}} {{u_1}} {{k*s_b}} {{z_b1}} {{ø_b}} #dc2626
#loop
#for k = -n_by : n_by
buis {{k*s_b}} {{-v_1}} {{z_b2}} {{k*s_b}} {{v_1}} {{z_b2}} {{ø_b}} #dc2626
#loop
// bijleg boven de paal, over de kolomstrook, tussen de staven van het net
#for k = -n_jx - 1 : n_jx
buis {{-l_bx/2}} {{(k + 0.5)*s_bb}} {{z_b1}} {{l_bx/2}} {{(k + 0.5)*s_bb}} {{z_b1}} {{ø_bb}} #d97706
#loop
#for k = -n_jy - 1 : n_jy
buis {{(k + 0.5)*s_bb}} {{-l_by/2}} {{z_b2}} {{(k + 0.5)*s_bb}} {{l_by/2}} {{z_b2}} {{ø_bb}} #d97706
#loop
// onder in de ponskop een net, onder in de stroken de bijleg
#if kop ≡ 1
#for k = -n_kx : n_kx
buis {{-b_k/2 + c_nom}} {{k*s_o}} {{z_k}} {{b_k/2 - c_nom}} {{k*s_o}} {{z_k}} {{ø_o}} #2563eb
buis {{k*s_o}} {{-b_k/2 + c_nom}} {{z_k + ø_o}} {{k*s_o}} {{b_k/2 - c_nom}} {{z_k + ø_o}} {{ø_o}} #2563eb
#loop
#end if
#if st_x ≡ 1
#for k = -n_sx : n_sx
buis {{-u_1}} {{k*s_bs}} {{z_s}} {{u_1}} {{k*s_bs}} {{z_s}} {{ø_bs}} #7c3aed
#loop
#end if
#if st_y ≡ 1
#for k = -n_sx : n_sx
buis {{k*s_bs}} {{-v_1}} {{z_s + st_x*ø_bs}} {{k*s_bs}} {{v_1}} {{z_s + st_x*ø_bs}} {{ø_bs}} #7c3aed
#loop
#end if
// stoelen: lintstoelen in x, om de meter, tussen de netten
#for k = -n_st : n_st - 1
buis {{-u_1}} {{(k + 0.5)*s_st}} {{z_st1}} {{u_1}} {{(k + 0.5)*s_st}} {{z_st1}} 0.006 #16a34a
buis {{-u_1}} {{(k + 0.5)*s_st - 0.04 m}} {{z_st0}} {{u_1}} {{(k + 0.5)*s_st - 0.04 m}} {{z_st0}} 0.005 #16a34a
buis {{-u_1}} {{(k + 0.5)*s_st + 0.04 m}} {{z_st0}} {{u_1}} {{(k + 0.5)*s_st + 0.04 m}} {{z_st0}} 0.005 #16a34a
#for zz = 0 : n_zz - 1
buis {{-u_1 + zz*p_zz}} {{(k + 0.5)*s_st - 0.04 m}} {{z_st0}} {{-u_1 + (zz + 0.5)*p_zz}} {{(k + 0.5)*s_st}} {{z_st1}} 0.005 #16a34a
buis {{-u_1 + (zz + 0.5)*p_zz}} {{(k + 0.5)*s_st}} {{z_st1}} {{-u_1 + (zz + 1)*p_zz}} {{(k + 0.5)*s_st - 0.04 m}} {{z_st0}} 0.005 #16a34a
buis {{-u_1 + zz*p_zz}} {{(k + 0.5)*s_st + 0.04 m}} {{z_st0}} {{-u_1 + (zz + 0.5)*p_zz}} {{(k + 0.5)*s_st}} {{z_st1}} 0.005 #16a34a
buis {{-u_1 + (zz + 0.5)*p_zz}} {{(k + 0.5)*s_st}} {{z_st1}} {{-u_1 + (zz + 1)*p_zz}} {{(k + 0.5)*s_st + 0.04 m}} {{z_st0}} 0.005 #16a34a
#loop
#loop
// ponswapening: deuvelrails in acht richtingen, de eerste deuvel op 0,5·d, dan om de 0,75·d
#if ponswap ≡ 1
#for k = 0 : 7
buis {{r_pw(0)*cos(k*π/4)}} {{r_pw(0)*sin(k*π/4)}} {{-t_loc(r_pw(0)*cos(k*π/4); r_pw(0)*sin(k*π/4)) + c_nom}} {{r_pw(n_p - 1)*cos(k*π/4)}} {{r_pw(n_p - 1)*sin(k*π/4)}} {{-t_loc(r_pw(0)*cos(k*π/4); r_pw(0)*sin(k*π/4)) + c_nom}} {{ø_pw/2}} #0f766e
#for jj = 0 : n_p - 1
buis {{r_pw(jj)*cos(k*π/4)}} {{r_pw(jj)*sin(k*π/4)}} {{-t_loc(r_pw(jj)*cos(k*π/4); r_pw(jj)*sin(k*π/4)) + c_nom}} {{r_pw(jj)*cos(k*π/4)}} {{r_pw(jj)*sin(k*π/4)}} {{-c_nom}} {{ø_pw}} #0f766e
buis {{r_pw(jj)*cos(k*π/4)}} {{r_pw(jj)*sin(k*π/4)}} {{-c_nom - 0.6*ø_pw}} {{r_pw(jj)*cos(k*π/4)}} {{r_pw(jj)*sin(k*π/4)}} {{-c_nom}} {{3*ø_pw}} #0f766e
#loop
#loop
#end if
@end
#show
'<span style="color:#2563eb">■</span> net onder Ø'ø_o/mm'-'s_o/mm' &nbsp; <span style="color:#dc2626">■</span> net boven Ø'ø_b/mm'-'s_b/mm' &nbsp; <span style="color:#d97706">■</span> bijleg boven Ø'ø_bb/mm'-'s_bb/mm' &nbsp; <span style="color:#16a34a">■</span> stoelen h = 'h_st/mm' mm
#if st_x + st_y > 0
'<span style="color:#7c3aed">■</span> bijleg onder in de strook Ø'ø_bs/mm'-'s_bs/mm'
#end if
#if ponswap ≡ 1
'<span style="color:#0f766e">■</span> ponswapening: 8 deuvelrails Ø'ø_pw/mm' met 'n_p' deuvels, de eerste op 0,5·d van de paalkop, dan om de 0,75·d (d = 'round(d_pw/mm)' mm)
#end if
'<i>De wapening rond een binnenpaal, een veld groot, met de beton als omtrek; de netten lopen door over de hele vloer. Draai het beeld met de muis.</i><span class="alleen-scherm"></span>
#else
'<b style="color:#b91c1c">Nog niet gerekend.</b> De momenten, de wapening per zone, de bijleg en de paalreacties volgen uit Open FEM Studio en staan hier zodra het antwoord er is. Zonder antwoord staan ze er niet: er is geen terugval op een andere rekenkern.
#end if

# Paalreactie en pons

#if gerekend ≡ 1
#hide
'De reactie per paal (rij voor rij, de onderste eerst), de grootste over de UGT-combinaties, per soort paal.
R_hoek = 0 kN
R_rand = 0 kN
R_binnen = 0 kN
#for j = 0 : n_r
#for i = 0 : n_r
R_ij = max(take(j*(n_r + 1) + i + 1; vloer_UGT_vol_R); take(j*(n_r + 1) + i + 1; vloer_UGT_sb1_R); take(j*(n_r + 1) + i + 1; vloer_UGT_sb2_R))
r_ij = bool(i ≡ 0) + bool(i ≡ n_r) + bool(j ≡ 0) + bool(j ≡ n_r)
R_hoek = if(r_ij ≥ 2; max(R_hoek; R_ij); R_hoek)
R_rand = if(r_ij ≡ 1; max(R_rand; R_ij); R_rand)
R_binnen = if(r_ij ≡ 0; max(R_binnen; R_ij); R_binnen)
#loop
#loop
w_BGT = vloer_BGT_w_max
#show
R_binnen', binnenpaal<span class="kolom-3"></span>'
R_rand', randpaal<span class="kolom-3"></span>'
R_hoek', hoekpaal<span class="kolom-3"></span>'
R_paal = max(R_binnen; R_rand; R_hoek)', grootste paalreactie (rekenwaarde)<span class="kolom-2"></span>'
w_BGT', grootste doorbuiging, karakteristiek<span class="kolom-2"></span>'
'Pons boven de paal met de module Pons: V<sub>Ed</sub> = R<sub>binnen</sub>, R<sub>rand</sub> of R<sub>hoek</sub> met de ligging binnen, rand of hoek, en de plaatdikte bij de paal t = 't_p/mm' mm.
'<i>Voeg de module Pons toe en typ in het veld V<sub>Ed</sub> de verwijzing naar dit blad, met het kenmerk uit de projectboom: #1.R_binnen als dit blad #1 is (of #1.R_rand, #1.R_hoek, #1.R_paal).</i><span class="alleen-scherm"></span>
#else
'<b style="color:#b91c1c">Nog niet gerekend.</b> De paalreacties volgen uit Open FEM Studio.
#end if

# Krimp

L_vloer = ?{40}*(m)', lengte van de vloer zonder voeg<span class="kolom-3"></span>'
c_cem = ?{320}*(kg/m^3)', cementgehalte<span class="kolom-3"></span>'
RH = ?{60}', relatieve vochtigheid (%)<span class="kolom-3"></span>'
@select cement "Cementsoort (Eurocode, bijlage B)"
  Klasse N (CEM I 42,5 N, CEM II) = 2
  Klasse S (CEM III, langzaam) = 1
  Klasse R (CEM I 42,5 R, 52,5) = 3
@end
R_ax = ?{0.5}', verhinderingsgraad (0 vrij, 1 volledig)<span class="kolom-3"></span>'
w_lim = ?{0.3}*(mm)', toelaatbare scheurwijdte<span class="kolom-3"></span>'
'<i>De vloer droogt aan de bovenkant uit. Palen en randen verhinderen de krimp gedeeltelijk: 0 is een vloer die vrij kan krimpen, 1 een volledig verhinderde. Minder cement (en minder water) geeft minder cementlijm en minder krimp. De Eurocode kent het cementgehalte niet; ACI 209R-92 wel, met de factor 0,75 + 0,00061·c.</i><span class="alleen-scherm"></span>

#hide
'NEN-EN 1992-1-1 bijlage B: uitdrogingskrimp en autogene krimp, eindwaarde.
α_ds1 = if(cement ≡ 1; 3; if(cement ≡ 3; 6; 4))
α_ds2 = if(cement ≡ 1; 0.13; if(cement ≡ 3; 0.11; 0.12))
β_RH = 1.55*(1 - (RH/100)^3)
ε_cd0 = 0.85*((220 + 110*α_ds1)*exp(-α_ds2*(f_cm/MPa)/10))*1e-6*β_RH
h_0 = 2*h/(1 mm)
k_h = if(h_0 ≤ 100; 1; if(h_0 ≤ 200; 1 - 0.15*(h_0 - 100)/100; if(h_0 ≤ 300; 0.85 - 0.10*(h_0 - 200)/100; if(h_0 ≤ 500; 0.75 - 0.05*(h_0 - 300)/200; 0.70))))
ε_ca = 2.5*(f_ck/MPa - 10)*1e-6
'ACI 209R-92: 780·10⁻⁶ maal de factoren voor cementgehalte, vochtigheid en
'volume/oppervlak (bovenkant: V/S = h); de andere factoren 1.
γ_c,ACI = 0.75 + 0.00061*c_cem/(kg/m^3)
γ_RH,ACI = if(RH ≤ 80; 1.40 - 1.02*RH/100; 3.00 - 3.0*RH/100)
γ_vs,ACI = 1.2*exp(-0.00472*h/(1 mm))
#show
ε_cs,EC = (k_h*ε_cd0 + ε_ca)*1000', ‰, bijlage B (B.11) en (3.12)<span class="kolom-2"></span>'
ε_cs,ACI = 780e-6*γ_c,ACI*γ_RH,ACI*γ_vs,ACI*1000', ‰, ACI 209R-92 met c = 'c_cem/(kg/m^3)' kg/m³<span class="kolom-2"></span>'
#hide
ε_cs = max(ε_cs,EC; ε_cs,ACI)/1000
#show
ΔL = ε_cs*L_vloer to mm', vrije verkorting over de vloer (de grootste van beide)<span class="kolom-2"></span>'
Δ_voeg = ΔL/2', beweging aan elk eind<span class="kolom-2"></span>'

#hide
'Minimumwapening bij een opgelegde vervorming (7.3.2, (7.1)): trek over de hele
'doorsnede, k_c = 1, k voor h ≤ 300 mm 1,0 en vanaf 800 mm 0,65; per laag de helft.
k_Amin = if(h ≤ 300 mm; 1; if(h ≥ 800 mm; 0.65; 1 - 0.35*(h - 300 mm)/(500 mm)))
A_ct = b_s1*h
'Staalspanning bij w_lim en de dikste staaf van de netten, uit tabel 7.2N zonder correctie (7.6N).
ø_max = max(ø_o; ø_b)
σ_03 = if(ø_max ≤ 10 mm; 320; if(ø_max ≤ 12 mm; 280; if(ø_max ≤ 16 mm; 240; 200)))
σ_02 = if(ø_max ≤ 8 mm; 280; if(ø_max ≤ 12 mm; 240; if(ø_max ≤ 16 mm; 200; 160)))
σ_04 = if(ø_max ≤ 12 mm; 320; if(ø_max ≤ 16 mm; 280; if(ø_max ≤ 20 mm; 240; 200)))
σ_s = if(w_lim ≤ 0.2 mm; σ_02; if(w_lim ≤ 0.3 mm; σ_03; σ_04))*N/mm^2
A_s,min = k_Amin*f_ctm*A_ct/σ_s to mm^2
A_o = a_o*b_s1 to mm^2
A_b = a_b*b_s1 to mm^2
'Scheurwijdte bij verhinderde krimp (NEN-EN 1992-3 bijlage M): (ε_sm − ε_cm) = R_ax·ε_cs,
'met s_r,max uit (7.11) voor de onderste laag.
ρ_eff = A_o/(b_s1*min(2.5*(h - d_o(h)); h/2))
s_rmax = 3.4*c_nom + 0.425*0.8*1.0*ø_o/ρ_eff
w_k = s_rmax*R_ax*ε_cs to mm
UC_krimp = w_k/w_lim
UC_Amin = A_s,min/(A_o + A_b)
#show
A_s,min', (7.1) voor de hele doorsnede, tegen de netten onder en boven, k = 'k_Amin', σ<sub>s</sub> = 'σ_s/(N/mm^2)' N/mm²<span class="kolom-2"></span>'
w_k', geschatte scheurwijdte, s<sub>r,max</sub> = 'round(s_rmax/(1 mm))' mm, R<sub>ax</sub> = 'R_ax'<span class="kolom-2"></span>'

# Samenvatting

#hide
c_1k = "#b91c1c"
c_2k = "#b45309"
c_3k = "#047857"
kleur(u) = if(u > 1; c_1k; if(u > 0.9; c_2k; c_3k))
oordeel(u) = if(u ≤ 1; "voldoet"; "voldoet niet")
#show
'<table style="width:100%; border-collapse:collapse; font-size:0.95em;">
'<tr style="border-bottom:2px solid #374151;"><th style="text-align:left; padding:2px 8px;">Toets</th><th style="text-align:right; padding:2px 8px;">UC</th><th style="text-align:left; padding:2px 8px;"></th></tr>
#if gerekend ≡ 1
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:2px 8px;">Net onder (veld, rand, hoek)</td><td style="text-align:right; padding:2px 8px; font-weight:700; color:'kleur(UC_o)'">'round(UC_o; 2)'</td><td style="padding:2px 8px; color:'kleur(UC_o)'">'oordeel(UC_o)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:2px 8px;">Net boven en bijleg (palen, kop, strook)</td><td style="text-align:right; padding:2px 8px; font-weight:700; color:'kleur(UC_b)'">'round(UC_b; 2)'</td><td style="padding:2px 8px; color:'kleur(UC_b)'">'oordeel(UC_b)'</td></tr>
#else
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:2px 8px;">Wapening uit de momenten</td><td style="text-align:right; padding:2px 8px;">–</td><td style="padding:2px 8px; color:#b91c1c; font-weight:700;">nog niet gerekend</td></tr>
#end if
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:2px 8px;">Minimumwapening krimp (7.1)</td><td style="text-align:right; padding:2px 8px; font-weight:700; color:'kleur(UC_Amin)'">'round(UC_Amin; 2)'</td><td style="padding:2px 8px; color:'kleur(UC_Amin)'">'oordeel(UC_Amin)'</td></tr>
'<tr style="border-bottom:1px solid #e5e7eb;"><td style="padding:2px 8px;">Scheurwijdte door krimp</td><td style="text-align:right; padding:2px 8px; font-weight:700; color:'kleur(UC_krimp)'">'round(UC_krimp; 2)'</td><td style="padding:2px 8px; color:'kleur(UC_krimp)'">'oordeel(UC_krimp)'</td></tr>
'</table>
'Pons boven de paal: met de module Pons. Buiten dit blad: puntlasten (wielen, stellingpoten), vermoeiing, temperatuur, de paal zelf en de voegen.
